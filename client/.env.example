# ==============================================================================
# TechTent E-Commerce Frontend Environment Configuration (.env.example)
#
# Copy this file to .env to configure your local development environment:
#   cp client/.env.example client/.env
# ==============================================================================

# Base URL of the TechTent API server.
# In local development using the Vite dev server proxy, leave empty or set to http://localhost:5000.
# In production on Cloud Run, set to the backend service URL (e.g. https://api-xxxx-uc.a.run.app).
# VITE_API_URL=http://localhost:5000
