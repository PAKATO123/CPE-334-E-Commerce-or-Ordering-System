# TechTent frontend: Vite development server is http://localhost:5173.
# Leave VITE_API_URL empty: Vite proxies /api to http://localhost:3000.
# Production uses the unified Cloud Run container (or Compose Nginx), so
# relative /api requests stay on the same origin. No separate API URL is needed.
# Vite embeds this non-secret value at build time; never put secrets here.
VITE_API_URL=
