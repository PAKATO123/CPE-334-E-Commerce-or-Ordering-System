# ==============================================================================
# TechTent E-Commerce Backend Environment Configuration (.env.example)
#
# Copy this file to .env to configure your local development environment:
#   cp server/.env.example server/.env
#
# Cloud Run and Secret Manager will set these same variables in production.
# Never commit real passwords, tokens, or production database credentials here.
# ==============================================================================

# Port the backend server listens on. Cloud Run injects this automatically.
PORT=3000

# PostgreSQL connection string for Prisma ORM.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techtent?schema=public"

# Secret key used to sign session cookies in express-session.
SESSION_SECRET="ecommerce-session-secret-key-cpe334"

# ------------------------------------------------------------------------------
# Optional / Production Settings (uncomment and customize as needed)
# ------------------------------------------------------------------------------

# Application runtime environment: "development", "test", or "production".
# deploy/deploy.sh sets this to "production".
# NODE_ENV=development

# Enforce secure HTTPS-only cookies (recommended in production with SSL).
# COOKIE_SECURE=false

# Allowed web origins for CORS, comma-separated. Default: allows all origins.
# CORS_ORIGIN=http://localhost:5173

# Bootstrap administrator password: required in production, from Secret Manager.
# ADMIN_PASSWORD=change-me
# Demo users are created only when explicitly true; default false everywhere.
# SEED_DEMO_DATA=false
# Required in production when demo seeding is enabled, from Secret Manager.
# DEMO_USER_PASSWORD=change-me
# SESSION_SECRET must be at least 32 characters in production; generated once
# in Secret Manager. Keep it stable across releases; never use this example.
# Production always uses secure cookies behind the trusted HTTPS proxy.

# ------------------------------------------------------------------------------
# Test Environment Safety Controls (isolated disposable tests only)
# ------------------------------------------------------------------------------

# Safety gate: set to "1" to permit running the integration test database suite.
# TECHTENT_ALLOW_DATABASE_TESTS=1

# Dedicated loopback test container URL on port 55435 (prevents dev data loss).
# TECHTENT_TEST_DATABASE_URL="postgresql://techtent_test:techtent_test_local_only@127.0.0.1:55435/techtent_test?schema=public"
